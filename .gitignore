# Repo-wide noise only.
# Per-project rules live in each project's own .gitignore:
#   hr-app-backend/.gitignore        (VisualStudio template: bin/, obj/, .vs/)
#   hr-app-frontend-new/.gitignore   (CRA: /node_modules, /build, /coverage)
#   hr-app-frontend/front/.gitignore (Vite: dist, logs)

# IDE / editor
.vs/
.idea/

# OS
.DS_Store
Thumbs.db

# Local environment / secrets
*.env
.env.local

# Deployment credentials and output. This repository is public: a publish profile carries
# the Web App's deployment password, and production settings belong in App Service, never
# in a file here (docs/DEPLOY.md).
*.PublishSettings
*publish-profile*.xml
*.azurePubxml
appsettings.Production.json
appsettings.*.local.json
/publish/

# Claude Code per-user permissions (may embed commands with tokens)
.claude/settings.local.json
